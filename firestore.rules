rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Lookup role dari users/{uid}. Ini query tambahan per request,
    // jadi jangan dipanggil berkali-kali dalam satu match block.
    function getUserRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return getUserRole() == 'admin';
    }

    // USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // PENTING: batasi role saat create. Tanpa ini, user bisa self-assign
      // role='admin' langsung lewat Firestore SDK, bukan cuma lewat app kita.
      allow create: if isOwner(userId)
        && request.resource.data.role in ['customer', 'seller'];
      // User boleh update profil sendiri TAPI tidak boleh ganti role sendiri.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // CATEGORIES — dikelola admin, publik boleh baca.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // BUSINESS APPLICATIONS — draft/revisi milik seller sendiri.
    match /businessApplications/{applicationId} {
      allow read: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'draft';
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        resource.data.status in ['draft', 'revision_required'] &&
        request.resource.data.status in ['draft', 'submitted'];
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // BUSINESSES — publik hanya boleh baca yang approved.
    match /businesses/{businessId} {
      allow read: if resource.data.status == 'approved' ||
        (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin()));
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['status', 'verification', 'banking', 'ownerId']));
      allow delete: if isAdmin();
    }

    // PRODUCTS — publik hanya baca yang approved. Owner boleh edit rutin
    // tanpa moderasi ulang selama status tidak berubah.
    match /products/{productId} {
      allow read: if resource.data.status == 'approved' ||
        (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin()));
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'draft';
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerId', 'businessId']) &&
          (
            request.resource.data.status == resource.data.status ||
            (resource.data.status in ['draft', 'rejected'] &&
              request.resource.data.status == 'submitted') ||
            request.resource.data.status == 'archived'
          ));
      allow delete: if isAdmin();
    }

    // SERVICES — sama persis polanya dengan PRODUCTS.
    match /services/{serviceId} {
      allow read: if resource.data.status == 'approved' ||
        (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin()));
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'draft';
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerId', 'businessId']) &&
          (
            request.resource.data.status == resource.data.status ||
            (resource.data.status in ['draft', 'rejected'] &&
              request.resource.data.status == 'submitted') ||
            request.resource.data.status == 'archived'
          ));
      allow delete: if isAdmin();
    }

    // CARTS — satu dokumen per customer (doc ID = uid).
    match /carts/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ORDERS — customer bikin order-nya sendiri, lalu boleh update SEKALI
    // untuk kirim bukti pembayaran (pending_payment -> payment_submitted),
    // tidak bisa sentuh field harga/item. Verifikasi selanjutnya cuma admin.
    // Phase 15: seller boleh baca & majukan status lewat sellerId (field
    // statis di order, bukan get() ke businesses — supaya query list milik
    // seller tidak rapuh), dan customer boleh konfirmasi shipped->completed.
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.customerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid ||
         get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid ||
         isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'pending_payment' &&
        request.resource.data.total ==
          request.resource.data.subtotal + request.resource.data.shippingCost &&
        (
          !('sellerId' in request.resource.data) ||
          request.resource.data.sellerId ==
            get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId
        );
      // Customer: kirim bukti pembayaran.
      allow update: if isSignedIn() && resource.data.customerId == request.auth.uid &&
        resource.data.status == 'pending_payment' &&
        request.resource.data.status == 'payment_submitted' &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['customerId', 'businessId', 'sellerId', 'items', 'subtotal', 'shippingCost',
                   'commissionRate', 'commissionAmount', 'total', 'shipping', 'createdAt']);
      // Customer: konfirmasi pesanan diterima.
      allow update: if isSignedIn() && resource.data.customerId == request.auth.uid &&
        resource.data.status == 'shipped' &&
        request.resource.data.status == 'completed' &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['customerId', 'businessId', 'sellerId', 'items', 'subtotal', 'shippingCost',
                   'commissionRate', 'commissionAmount', 'total', 'shipping', 'createdAt',
                   'paymentProofUrl', 'paymentRejectionReason']);
      // Seller: proses & kirim pesanan (payment_verified -> processing -> shipped).
      allow update: if isSignedIn() && resource.data.sellerId == request.auth.uid &&
        (
          (resource.data.status == 'payment_verified' && request.resource.data.status == 'processing') ||
          (resource.data.status == 'processing' && request.resource.data.status == 'shipped')
        ) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['customerId', 'businessId', 'sellerId', 'items', 'subtotal', 'shippingCost',
                   'commissionRate', 'commissionAmount', 'total', 'shipping', 'createdAt',
                   'paymentProofUrl', 'paymentRejectionReason']);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // SHIPPING METHODS — dikelola admin, publik boleh baca (dipakai saat checkout).
    match /shippingMethods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PLATFORM SETTINGS — satu dokumen singleton ("default") berisi komisi
    // platform saat ini. Publik boleh baca (dibutuhkan saat checkout menghitung
    // komisi), hanya admin yang boleh mengubah.
    match /platformSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny — collection lain (payments terpisah kalau ada, dst.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
